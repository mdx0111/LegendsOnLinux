#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Start LegendsOnLinux from this directory (a checkout or a package's
/usr/lib/legends-on-linux)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, here)
# The .deb bundles PySide6 here (Ubuntu LTS releases package none).
vendor = os.path.join(here, "vendor")
if os.path.isdir(vendor):
    sys.path.insert(1, vendor)

from legends_on_linux.cli import main  # noqa: E402

sys.exit(main())
