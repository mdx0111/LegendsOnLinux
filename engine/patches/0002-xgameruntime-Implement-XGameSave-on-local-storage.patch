+}
+
+/* 29 */
+static HRESULT WINAPI gs_SubmitUpdateResult( void *iface, XAsyncBlock *async )
+{
+    TRACE( "async %p\n", async );
+    return gs_async_get_result( async, gs_SubmitUpdateAsync, 0, NULL, NULL );
+}
