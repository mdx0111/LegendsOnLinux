+/* 23 */
+static HRESULT WINAPI gs_CreateUpdate( void *iface, struct gs_container *container, const char *display_name, struct gs_update **out )
+{
+    struct gs_update *update;
+
+    TRACE( "container %p, display name %s, update %p\n", container, debugstr_a( display_name ), out );
+    if (!container || !out) return E_INVALIDARG;
+    if (!(update = calloc( 1, sizeof(*update) ))) return E_OUTOFMEMORY;
+    update->container = container;
+    update->display_name = display_name ? gs_strdup( display_name ) : NULL;
+    *out = update;
+    return S_OK;
+}
+
+/* 24 */
+static void WINAPI gs_CloseUpdate( void *iface, struct gs_update *update )
+{
+    UINT32 i;
+    TRACE( "update %p\n", update );
+    if (!update) return;
+    for (i = 0; i < update->count; i++)
+    {
+        free( update->ops[i].name );
+        free( update->ops[i].data );
+    }
+    free( update->ops );
+    free( update->display_name );
+    free( update );
+}
+
+static HRESULT gs_add_op( struct gs_update *update, const char *name, const BYTE *data, UINT32 size, BOOLEAN remove )
+{
+    struct gs_update_op *op;
+    WCHAR enc[MAX_PATH];
+
+    if (!update || !name || !*name || !gs_encode_name( name, enc, ARRAY_SIZE(enc) )) return E_INVALIDARG;
+    if (size > GS_MAX_BLOB_SIZE) return E_GS_UPDATE_TOO_BIG;
+    if (update->count == update->capacity)
+    {
+        UINT32 capacity = update->capacity ? update->capacity * 2 : 8;
+        if (!(op = realloc( update->ops, capacity * sizeof(*op) ))) return E_OUTOFMEMORY;
+        update->ops = op;
+        update->capacity = capacity;
+    }
+    op = &update->ops[update->count];
+    memset( op, 0, sizeof(*op) );
+    if (!(op->name = gs_strdup( name ))) return E_OUTOFMEMORY;
+    if (size && !(op->data = malloc( size )))
+    {
+        free( op->name );
+        return E_OUTOFMEMORY;
+    }
+    if (size) memcpy( op->data, data, size );
+    op->size = size;
+    op->remove = remove;
+    update->count++;
+    return S_OK;
+}
+
+/* 25 */
+static HRESULT WINAPI gs_SubmitBlobWrite( void *iface, struct gs_update *update, const char *name, const BYTE *data, SIZE_T size )
+{
+    TRACE( "update %p, name %s, data %p, size %Iu\n", update, debugstr_a( name ), data, size );
+    if (size && !data) return E_INVALIDARG;
+    if (size > GS_MAX_BLOB_SIZE) return E_GS_UPDATE_TOO_BIG;
+    return gs_add_op( update, name, data, (UINT32)size, FALSE );
+}
+
+/* 26 */
