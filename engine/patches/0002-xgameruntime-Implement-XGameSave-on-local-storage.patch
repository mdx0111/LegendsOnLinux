+static BOOL gs_container_exists( const struct gs_provider *provider, const char *name, WCHAR *enc )
+{
+    WCHAR dir[MAX_PATH];
+    DWORD attr;
+    if (!gs_encode_name( name, enc, MAX_PATH ) || !gs_join( dir, provider->root, enc )) return FALSE;
+    attr = GetFileAttributesW( dir );
+    return attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+/* 13 */
+static HRESULT WINAPI gs_GetContainerInfo( void *iface, struct gs_provider *provider, const char *name,
+                                           void *context, XGameSaveContainerInfoCallback callback )
+{
+    WCHAR enc[MAX_PATH];
+    TRACE( "provider %p, name %s, context %p, callback %p\n", provider, debugstr_a( name ), context, callback );
+    if (!provider || !callback) return E_INVALIDARG;
+    AcquireSRWLockShared( &gs_lock );
+    if (gs_container_exists( provider, name, enc )) gs_report_container( provider, enc, callback, context );
+    ReleaseSRWLockShared( &gs_lock );
+    return S_OK;
+}
+
+/* 14 */
+static HRESULT WINAPI gs_EnumerateContainerInfo( void *iface, struct gs_provider *provider, void *context,
+                                                 XGameSaveContainerInfoCallback callback )
+{
+    TRACE( "provider %p, context %p, callback %p\n", provider, context, callback );
+    return gs_enumerate_containers( provider, NULL, context, callback );
+}
+
+/* 15 */
+static HRESULT WINAPI gs_EnumerateContainerInfoByName( void *iface, struct gs_provider *provider, const char *prefix,
+                                                       void *context, XGameSaveContainerInfoCallback callback )
+{
+    TRACE( "provider %p, prefix %s, context %p, callback %p\n", provider, debugstr_a( prefix ), context, callback );
+    return gs_enumerate_containers( provider, prefix, context, callback );
+}
+
+/* 16 */
+static HRESULT WINAPI gs_CreateContainer( void *iface, struct gs_provider *provider, const char *name, struct gs_container **out )
+{
+    struct gs_container *container;
+    WCHAR enc[MAX_PATH];
+
+    TRACE( "provider %p, name %s, container %p\n", provider, debugstr_a( name ), out );
+    if (!provider || !out) return E_INVALIDARG;
+    *out = NULL;
+    if (!name || !*name || strlen( name ) > 255 || !gs_encode_name( name, enc, ARRAY_SIZE(enc) ))
+        return E_GS_INVALID_CONTAINER_NAME;
+    if (!(container = calloc( 1, sizeof(*container) ))) return E_OUTOFMEMORY;
+    container->provider = provider;
+    if (!(container->name = gs_strdup( name )) || !gs_join( container->dir, provider->root, enc ))
+    {
+        free( container->name );
+        free( container );
+        return E_GS_INVALID_CONTAINER_NAME;
+    }
+    /* Like the real service, the container appears on disk with its first update. */
+    *out = container;
+    return S_OK;
+}
+
+/* 17 */
+static void WINAPI gs_CloseContainer( void *iface, struct gs_container *container )
+{
+    TRACE( "container %p\n", container );
+    if (!container) return;
+    free( container->name );
+    free( container );
+}
+
+struct gs_blob_enum
+{
+    const char *prefix;
+    void *context;
+    XGameSaveBlobInfoCallback callback;
+};
+
+static BOOL gs_report_blob( const char *name, const WIN32_FIND_DATAW *fd, void *ctx )
+{
+    struct gs_blob_enum *e = ctx;
+    XGameSaveBlobInfo info;
+
+    if (e->prefix && strncmp( name, e->prefix, strlen( e->prefix ) )) return TRUE;
+    info.name = name;
+    info.size = fd->nFileSizeLow;
+    return e->callback( &info, e->context );
+}
+
+static HRESULT gs_enumerate_blobs( struct gs_container *container, const char *prefix, void *context,
+                                   XGameSaveBlobInfoCallback callback )
+{
+    struct gs_blob_enum e = { prefix, context, callback };
+    if (!container || !callback) return E_INVALIDARG;
+    AcquireSRWLockShared( &gs_lock );
+    gs_for_each_blob( container->dir, gs_report_blob, &e );
+    ReleaseSRWLockShared( &gs_lock );
+    return S_OK;
+}
+
+/* 18 */
+static HRESULT WINAPI gs_EnumerateBlobInfo( void *iface, struct gs_container *container, void *context,
+                                            XGameSaveBlobInfoCallback callback )
+{
+    TRACE( "container %p, context %p, callback %p\n", container, context, callback );
+    return gs_enumerate_blobs( container, NULL, context, callback );
+}
+
+/* 19 */
+static HRESULT WINAPI gs_EnumerateBlobInfoByName( void *iface, struct gs_container *container, const char *prefix,
+                                                  void *context, XGameSaveBlobInfoCallback callback )
+{
+    TRACE( "container %p, prefix %s, context %p, callback %p\n", container, debugstr_a( prefix ), context, callback );
+    return gs_enumerate_blobs( container, prefix, context, callback );
+}
+
+/* 20 */
+static HRESULT WINAPI gs_ReadBlobData( void *iface, struct gs_container *container, const char **names,
+                                       UINT32 *count, SIZE_T size, XGameSaveBlob *blobs )
+{
+    struct gs_staged_blob *staged;
+    UINT32 staged_count;
+    SIZE_T required;
+    HRESULT hr;
+
+    TRACE( "container %p, names %p, count %p, size %Iu, blobs %p\n", container, names, count, size, blobs );
+    if (!count) return E_INVALIDARG;
+    if (FAILED( hr = gs_stage_blobs( container, names, *count, &staged, &staged_count, &required ) )) return hr;
+    if (size < required) hr = E_GS_PROVIDED_BUFFER_TOO_SMALL;
+    else if (SUCCEEDED( hr = gs_layout_blobs( staged, staged_count, size, blobs ) )) *count = staged_count;
+    gs_free_staged( staged, staged_count );
+    return hr;
+}
+
+/* 21 */
+static HRESULT WINAPI gs_ReadBlobDataAsync( void *iface, struct gs_container *container, const char **names,
+                                            UINT32 count, XAsyncBlock *async )
+{
+    struct gs_async *ctx;
+    UINT32 i;
+
+    TRACE( "container %p, names %p, count %u, async %p\n", container, names, count, async );
+    if (!container) return E_INVALIDARG;
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->kind = GS_ASYNC_READ;
+    ctx->container = container;
+    if (names && count)
+    {
+        if (!(ctx->names = calloc( count, sizeof(*ctx->names) )))
+        {
+            free( ctx );
+            return E_OUTOFMEMORY;
+        }
+        for (i = 0; i < count; i++)
+        {
+            TRACE( "  blob %s\n", debugstr_a( names[i] ) );
+            ctx->names[i] = gs_strdup( names[i] );
+        }
+        ctx->name_count = count;
+    }
+    return gs_async_start( ctx, async, gs_ReadBlobDataAsync, "XGameSaveReadBlobDataAsync" );
+}
+
+/* 22 */
+static HRESULT WINAPI gs_ReadBlobDataResult( void *iface, XAsyncBlock *async, SIZE_T size, XGameSaveBlob *blobs, UINT32 *count )
+{
+    HRESULT hr;
+
+    TRACE( "async %p, size %Iu, blobs %p, count %p\n", async, size, blobs, count );
+    hr = gs_async_get_result( async, gs_ReadBlobDataAsync, size, blobs, NULL );
+    if (count) *count = SUCCEEDED( hr ) ? gs_count_laid_out_blobs( blobs, size ) : 0;
+    return hr;
+}
