# Fedora COPR "make srpm" entry point: COPR clones this repository and runs
#   make -f .copr/Makefile srpm outdir=<dir> spec=<ignored>
# The spec is generated by scripts/build-rpm.sh, so it builds the source rpm.

srpm:
	dnf -y install git rpm-build
	git config --global --add safe.directory '*'
	OUTDIR="$(outdir)" scripts/build-rpm.sh --head --srpm
